{
  "name": "@lijuhong1981/modelto3dtiles",
  "version": "1.1.4",
  "main": "main.js",
  "bin": "main.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:esbuild && npm run build:pkg",
    "build:clean": "rimraf dist && rimraf modelTo3DTiles.exe",
    "build:esbuild": "rimraf dist && node esbuild.config.js dev",
    "build:pkg": "rimraf modelTo3DTiles.exe && pkg . --targets node18-win-x64 --output modelTo3DTiles.exe --options max-old-space-size=24576",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "pkg": {
    "assets": [
      "node_modules/cesium/Build/CesiumUnminified/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "cesium": "^1.131.0",
    "draco3dgltf": "^1.5.7",
    "fs-extra": "^11.3.3",
    "gltf-pipeline": "^4.3.0",
    "obj2gltf": "^3.2.0",
    "path": "^0.12.7",
    "pkg": "^5.8.1",
    "sharp": "^0.34.5",
    "three": "^0.182.0",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.10"
  }
}
